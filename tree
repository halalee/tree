def check_for_updates_background():
    """Queries git origin in the background without blocking or interrupting the console."""
    global UPDATE_AVAILABLE, NEW_COMMIT_HASH
    try:
        git_dir = str(CURRENT_DIR)
        local_rev = subprocess.check_output(
            ["git", "-C", git_dir, "rev-parse", "HEAD"],
            stderr=subprocess.DEVNULL, timeout=2
        ).decode().strip()

        remote_line = subprocess.check_output(
            ["git", "-C", git_dir, "ls-remote", "origin", "main"],
            stderr=subprocess.DEVNULL, timeout=2.5
        ).decode().strip()

        if remote_line:
            remote_rev = remote_line.split()[0]
            if local_rev and remote_rev and local_rev != remote_rev:
                UPDATE_AVAILABLE = True
                NEW_COMMIT_HASH = remote_rev[:7]
    except Exception:
        pass

