# ==============================================================================
# SECURE ENCRYPTION / KEY VAULT (Obfuscated at rest via Host-Key Derivation)
# ==============================================================================
def _derive_host_key() -> bytes:
    try:
        with open("/etc/machine-id", "r") as f:
            host_id = f.read().strip()
    except Exception:
        host_id = "tree-default-static-salt-kali-sec"
    user_salt = os.getenv("USER", "kali")
    combo = f"{host_id}-{user_salt}-tree-key-protection-vault"
    return hashlib.sha256(combo.encode()).digest()

def encrypt_key(raw_key: str) -> str:
    key_bytes = _derive_host_key()
    raw_bytes = raw_key.encode("utf-8")
    encrypted = bytes([b ^ key_bytes[i % len(key_bytes)] for i, b in enumerate(raw_bytes)])
    return "enc:" + base64.b64encode(encrypted).decode("utf-8")

def decrypt_key(stored_val: str) -> str:
    if not stored_val.startswith("enc:"):
        return stored_val
    data = base64.b64decode(stored_val[4:])
    key_bytes = _derive_host_key()
    decrypted = bytes([b ^ key_bytes[i % len(key_bytes)] for i, b in enumerate(data)])
    return decrypted.decode("utf-8")

# ==============================================================================
# LIVE VALIDATION ENGINE FOR ALL PROVIDERS
# ==============================================================================
def validate_provider_key(provider: str, api_key: str) -> tuple[bool, str]:
    provider = provider.lower()
    k = api_key.strip()
    if len(k) < 6:
        return False, "Key is too short or empty."

    try:
        if provider == "gemini":
            url = f"https://generativelanguage.googleapis.com/v1beta/models?key={k}"
            res = requests.get(url, timeout=6)
            if res.status_code == 200:
                return True, "Active and valid."
            return False, f"Gemini rejected key (HTTP {res.status_code})"

        elif provider == "openai":
            url = "https://api.openai.com/v1/models"
            headers = {"Authorization": f"Bearer {k}"}
            res = requests.get(url, headers=headers, timeout=6)
            if res.status_code == 200:
                return True, "Active and valid."
            return False, f"OpenAI rejected key (HTTP {res.status_code})"

        elif provider == "claude":
            url = "https://api.anthropic.com/v1/models"
            headers = {"x-api-key": k, "anthropic-version": "2023-06-01"}
            res = requests.get(url, headers=headers, timeout=6)
            if res.status_code == 200 or "not_found_error" not in res.text:
                return True, "Active and valid."
            return False, f"Anthropic rejected key (HTTP {res.status_code})"

        elif provider == "openrouter":
            url = "https://openrouter.ai/api/v1/auth/key"
            headers = {"Authorization": f"Bearer {k}"}
            res = requests.get(url, headers=headers, timeout=6)
            if res.status_code == 200:
                return True, "Active and valid."
            return False, f"OpenRouter rejected key (HTTP {res.status_code})"

        return False, f"Unknown provider: {provider}"
    except requests.exceptions.RequestException as e:
        return False, f"Network error during verification: {e.__class__.__name__}"

# ==============================================================================
# CONFIG & VAULT STORAGE HANDLERS
