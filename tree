#!/usr/bin/env python3
import sys
import os
import json
import time
import requests
import markdown
from pathlib import Path
from rich.console import Console
from rich.table import Table
from rich.panel import Panel
from rich.markdown import Markdown
from rich.progress import Progress, SpinnerColumn, BarColumn, TextColumn, TimeRemainingColumn

CURRENT_DIR = Path(__file__).resolve().parent
if str(CURRENT_DIR) not in sys.path:
    sys.path.insert(0, str(CURRENT_DIR))

from core.scanner import ReconScanner, LocalNetworkScanner
from core.ai_engine import AIEngine
from core.pdf_generator import generate_pdf_report

console = Console()
CONFIG_PATH = Path.home() / ".tree_config.json"

BANNER = """[bold green]
  ████████╗██████╗ ███████╗███████╗
  ╚══██╔══╝██╔══██╗██╔════╝██╔════╝
     ██║   ██████╔╝█████╗  █████╗  
     ██║   ██╔══██╗██╔══╝  ██╔══╝  
     ██║   ██║  ██║███████╗███████╗
     ╚═╝   ╚═╝  ╚═╝╚══════╝╚══════╝[/bold green]
[dim]AI-Powered Penetration Testing & Vulnerability Assessment Console[/dim]
"""

def load_or_prompt_api_key() -> str:
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r") as f:
                data = json.load(f)
                key = data.get("gemini_api_key", "").strip()
                if key:
                    return key
        except Exception:
            pass

    console.print(Panel(
        "[bold yellow]First-Time Setup Required[/bold yellow]\n\n"
        "No saved Gemini API key found.\n"
        "Please enter your Google Gemini API key (it will be saved to ~/.tree_config.json):",
        border_style="yellow"
    ))
    
    while True:
        key = console.input("[bold cyan]Enter Gemini API Key: [/bold cyan]").strip()
        if key:
            save_api_key(key)
            console.print("[bold green][+] Key saved successfully.[/bold green]\n")
            return key
        console.print("[red][-] Key cannot be empty.[/red]")

def save_api_key(api_key: str):
    config_data = {"gemini_api_key": api_key}
    with open(CONFIG_PATH, "w") as f:
        json.dump(config_data, f, indent=2)
    os.chmod(CONFIG_PATH, 0o600)

class TreeConsole:
    def __init__(self):
        self.target = None
        self.last_results = None
        self.latest_report = None
        self.discovered_hosts = []
        self.api_key = load_or_prompt_api_key()
        self.ai = None
        try:
            self.ai = AIEngine(api_key=self.api_key)
        except Exception as e:
            console.print(f"[red][!] Error initializing AI Engine: {e}[/red]")

    def print_help(self):
        table = Table(title="Available Commands", border_style="green")
        table.add_column("Command", style="cyan", no_wrap=True)
        table.add_column("Description")
        table.add_row("netscan", "Scan local connected subnet with visual ARP progress")
        table.add_row("select <id>", "Select a discovered device ID as active target")
        table.add_row("set target <ip/host>", "Manually configure target IP or hostname")
        table.add_row("set api_key <key>", "Update and save a new Gemini API key")
        table.add_row("show options", "Display current configuration")
        table.add_row("scan", "Execute reconnaissance pipeline with step-by-step progress bar")
        table.add_row("analyze", "Stream Gemini AI vulnerability triage with immediate output")
        table.add_row("report", "Display the latest generated audit report")
        table.add_row("export [filename.pdf]", "Export the latest report to a color-styled PDF")
        table.add_row("clear", "Clear the terminal screen")
        table.add_row("exit / quit", "Exit the Tree console")
        console.print(table)

    def run(self):
        console.print(BANNER)
        console.print("[bold green][*][/bold green] Tree initialized. Type [cyan]help[/cyan] to get started.\n")

        while True:
            try:
                prompt_str = f"[bold green]tree[/bold green] ({self.target if self.target else 'no target'}) > "
                command = console.input(prompt_str).strip()

                if not command:
                    continue

                parts = command.split()
                cmd = parts[0].lower()

                if cmd in ["exit", "quit"]:
                    console.print("[green][*] Shutting down Tree console.[/green]")
                    break

                elif cmd == "help":
                    self.print_help()

                elif cmd == "clear":
                    os.system("clear" if os.name == "posix" else "cls")
                    console.print(BANNER)

                elif cmd == "netscan":
                    iface, cidr = LocalNetworkScanner.get_local_subnet()
                    if not cidr:
                        console.print("[red][-] Could not identify an active local network interface.[/red]")
                        continue

                    console.print(f"[bold green][*] Interface:[/bold green] [cyan]{iface}[/cyan] [bold green]| Subnet:[/bold green] [cyan]{cidr}[/cyan]")
                    
                    with Progress(
                        SpinnerColumn(),
                        TextColumn("[progress.description]{task.description}"),
                        BarColumn(bar_width=35, style="green"),
                        TimeRemainingColumn(),
                        console=console
                    ) as progress:
                        t = progress.add_task("[green]Sweeping local subnet for live hosts...", total=100)
                        progress.update(t, advance=30)
                        self.discovered_hosts = LocalNetworkScanner.discover_hosts(cidr)
                        progress.update(t, completed=100)

                    if not self.discovered_hosts:
                        console.print("[yellow][!] No active hosts responded on this subnet.[/yellow]")
                        continue

                    table = Table(title=f"Discovered Devices ({len(self.discovered_hosts)} hosts online)", border_style="green")
                    table.add_column("ID", style="bold cyan", justify="center")
                    table.add_column("IP Address", style="yellow")
                    table.add_column("MAC Address", style="white")
                    table.add_column("Vendor / Device Info", style="magenta")
                    table.add_column("Hostname", style="dim")

                    for idx, host in enumerate(self.discovered_hosts):
                        table.add_row(str(idx), host["ip"], host["mac"], host["vendor"], host["hostname"])
                    console.print(table)
                    console.print("[dim]Use [bold cyan]select <ID>[/bold cyan] to set an active target.[/dim]\n")

                elif cmd == "select" and len(parts) >= 2:
                    try:
                        idx = int(parts[1])
                        if 0 <= idx < len(self.discovered_hosts):
                            self.target = self.discovered_hosts[idx]["ip"]
                            console.print(f"[green][+] Target set to device #{idx}:[/green] [bold]{self.target}[/bold] ({self.discovered_hosts[idx]['vendor']})")
                        else:
                            console.print(f"[red][-] Invalid ID. Choose between 0 and {len(self.discovered_hosts) - 1}.[/red]")
                    except ValueError:
                        console.print("[red][-] Please provide a numerical index, e.g. 'select 0'[/red]")

                elif cmd == "set" and len(parts) >= 3:
                    sub_opt = parts[1].lower()
                    if sub_opt == "target":
                        self.target = parts[2]
                        console.print(f"[green][+] Target set to:[/green] [bold]{self.target}[/bold]")
                    elif sub_opt == "api_key":
                        new_key = parts[2]
                        save_api_key(new_key)
                        self.api_key = new_key
                        self.ai = AIEngine(api_key=self.api_key)
                        console.print("[green][+] API key updated and saved.[/green]")
                    else:
                        console.print(f"[red][-] Unknown option: {parts[1]}[/red]")

                elif cmd == "show" and len(parts) >= 2 and parts[1].lower() == "options":
                    t = Table(title="Current Configuration")
                    t.add_column("Option", style="cyan")
                    t.add_column("Value", style="bold")
                    t.add_row("TARGET", self.target or "None")
                    masked_key = (self.api_key[:6] + "..." + self.api_key[-4:]) if len(self.api_key) > 10 else "Configured"
                    t.add_row("API_KEY", masked_key)
                    t.add_row("AI_MODEL", "gemini-3.6-flash")
                    console.print(t)

                elif cmd == "scan":
                    if not self.target:
                        console.print("[red][-] Error: No target configured. Use 'set target <ip>' or 'select <id>'[/red]")
                        continue

                    scanner = ReconScanner(self.target)
                    with Progress(
                        SpinnerColumn(),
                        TextColumn("[progress.description]{task.description}"),
                        BarColumn(bar_width=35, style="cyan"),
                        console=console
                    ) as progress:
                        p_task = progress.add_task(f"[cyan]Reconnaissance on {self.target}...", total=3)

                        progress.update(p_task, description="[cyan]1/3 Fast TCP port sweep...")
                        scanner.quick_port_scan()
                        progress.advance(p_task, 1)

                        progress.update(p_task, description="[cyan]2/3 Service banners & version detection (Nmap)...")
                        scanner.scan_nmap()
                        progress.advance(p_task, 1)

                        progress.update(p_task, description="[cyan]3/3 Running Exploit-DB, SSH, and Web audits...")
                        # Run audits on the gathered services without restarting nmap
                        for svc in scanner.results["nmap_services"]:
                            if "error" in svc:
                                continue
                            port = svc.get("port")
                            name = svc.get("name", "").lower()
                            product = svc.get("product", "")
                            ver = svc.get("version", "")
                            banner_str = f"{product} {ver}".strip()

                            from core.scanner import ExploitDBCorrelator, ServiceAuditor, WebAuditor
                            search_term = product if product else name
                            matches = ExploitDBCorrelator.query(search_term, ver)
                            if matches:
                                scanner.results["exploitdb_matches"].append({
                                    "port": port,
                                    "service": f"{search_term} {ver}".strip(),
                                    "exploits": matches
                                })

                            if "ftp" in name or port == 21:
                                scanner.results["service_audits"]["ftp"] = ServiceAuditor.check_ftp_anonymous(scanner.target, port)

                            if "ssh" in name or port == 22:
                                ssh_banner = f"{product}_{ver}" if product else banner_str
                                scanner.results["service_audits"]["ssh"] = ServiceAuditor.audit_ssh_cves(ssh_banner)

                            if port in [80, 443, 8080, 8443] or "http" in name:
                                auditor = WebAuditor(scanner.target, port)
                                scanner.results["web_audits"].append({
                                    "port": port,
                                    "audit": auditor.audit()
                                })
                        progress.advance(p_task, 1)

                    self.last_results = scanner.results
                    console.print(f"\n[bold green][+] Reconnaissance completed for {self.target}![/bold green]")

                    if self.last_results.get("nmap_services"):
                        st = Table(title=f"Detected Services on {self.target}")
                        st.add_column("Port", style="cyan")
                        st.add_column("Service", style="yellow")
                        st.add_column("Product / Version", style="white")
                        for s in self.last_results["nmap_services"]:
                            if "error" not in s:
                                st.add_row(str(s.get("port")), str(s.get("name")), f"{s.get('product', '')} {s.get('version', '')}")
                        console.print(st)

                    if self.last_results.get("exploitdb_matches"):
                        et = Table(title="Local Exploit-DB Matches", border_style="red")
                        et.add_column("Port", style="cyan")
                        et.add_column("Service", style="yellow")
                        et.add_column("Exploit Title", style="white")
                        for match in self.last_results["exploitdb_matches"]:
                            for exp in match["exploits"]:
                                et.add_row(str(match["port"]), match["service"], exp["title"])
                        console.print(et)

                elif cmd == "analyze":
                    if not self.last_results:
                        console.print("[red][-] No scan data available. Run 'scan' first.[/red]")
                        continue
                    if not self.ai:
                        console.print("[red][-] AI engine is not configured properly.[/red]")
                        continue

                    console.print(f"[bold green][*] Starting analysis for target:[/bold green] [cyan]{self.target}[/cyan]")

                    def verbose_logger(msg: str):
                        console.print(f"  {msg}")

                    full_report = []
                    try:
                        console.print(f"\n[bold green]═══ AI Security Audit Stream ({self.target}) ═══[/bold green]\n")
                        for chunk in self.ai.stream_analyze_recon(self.last_results, verbose_callback=verbose_logger):
                            console.print(chunk, end="", highlight=False)
                            sys.stdout.flush()
                            full_report.append(chunk)

                        self.latest_report = "".join(full_report)
                        console.print("\n\n[bold green][+] Analysis complete. Ready to 'export report.pdf'[/bold green]\n")

                    except requests.exceptions.Timeout:
                        console.print("\n[red][-] Connection timed out. Check network connection or try another model.[/red]")
                    except Exception as e:
                        console.print(f"\n[red][-] Error during analysis: {str(e)}[/red]")

                elif cmd == "report":
                    if self.latest_report:
                        console.print(Panel(Markdown(self.latest_report), title="Saved Report", border_style="green"))
                    else:
                        console.print("[yellow][-] No report generated yet. Run 'analyze' first.[/yellow]")

                elif cmd == "export":
                    if not self.latest_report:
                        console.print("[yellow][-] No report to export. Run 'analyze' first.[/yellow]")
                        continue

                    filename = parts[1] if len(parts) >= 2 else f"report_{self.target.replace('.', '_')}.pdf"
                    if not filename.endswith(".pdf"):
                        filename += ".pdf"

                    export_path = os.path.join(os.getcwd(), filename)
                    with Progress(
                        SpinnerColumn(),
                        TextColumn("[progress.description]{task.description}"),
                        BarColumn(bar_width=35, style="green"),
                        console=console
                    ) as progress:
                        t = progress.add_task(f"[green]Compiling styled PDF ({filename})...", total=100)
                        progress.update(t, advance=50)
                        success = generate_pdf_report(self.latest_report, self.target, export_path)
                        progress.update(t, completed=100)

                    if success:
                        console.print(f"[bold green][+] Color-highlighted PDF report saved to:[/bold green] [cyan]{export_path}[/cyan]")
                    else:
                        console.print("[red][-] Failed to generate PDF report.[/red]")

                else:
                    console.print(f"[red][-] Unknown command: '{command}'. Type 'help' for available commands.[/red]")

            except (KeyboardInterrupt, EOFError):
                console.print("\n[green][*] Interrupted. Type 'exit' to quit.[/green]")
                continue

if __name__ == "__main__":
    app = TreeConsole()
    app.run()
