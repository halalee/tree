def load_config() -> dict:
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {"active_key_name": None, "keys": {}}

def save_config(cfg: dict):
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)
    os.chmod(CONFIG_PATH, 0o600)

def prompt_new_key_interactive(cfg: dict, default_active: bool = False) -> str:
    console.print("\n[bold cyan]Select AI Service:[/bold cyan]")
    console.print("  [bold green][1][/bold green] Google Gemini (Recommended / Free Tier)")
    console.print("  [bold green][2][/bold green] OpenAI (ChatGPT - GPT-4o / GPT-4o-mini)")
    console.print("  [bold green][3][/bold green] Anthropic (Claude 3.5 Sonnet / Haiku)")
    console.print("  [bold green][4][/bold green] OpenRouter (Multi-model / Llama-3 / DeepSeek)")

    choice_map = {"1": "gemini", "2": "openai", "3": "claude", "4": "openrouter"}
    selected_provider = "gemini"
    while True:
        c = console.input("[cyan]Select Provider [1-4] (Default: 1): [/cyan]").strip()
        if not c:
            selected_provider = "gemini"
            break
        if c in choice_map:
            selected_provider = choice_map[c]
            break
        console.print("[red][!] Invalid selection. Enter 1, 2, 3, or 4.[/red]")

    while True:
        alias = console.input("[cyan]Enter a unique name for this API key (e.g. 'my-gemini'): [/cyan]").strip()
        if not alias:
            console.print("[red][!] Name cannot be empty.[/red]")
            continue
        if alias in cfg.get("keys", {}):
            console.print(f"[yellow][!] An API key with the name '{alias}' already exists. Overwrite? (y/n): [/yellow]", end="")
            if console.input().strip().lower() != "y":
                continue
        break

    while True:
        raw_key = console.input(f"[cyan]Enter {selected_provider.upper()} API Key: [/cyan]").strip()
        if not raw_key:
            console.print("[red][!] Key cannot be empty.[/red]")
            continue

        with console.status(f"[cyan]Testing {selected_provider.upper()} API key validity...", spinner="dots"):
            is_valid, reason = validate_provider_key(selected_provider, raw_key)

        if is_valid:
            if "keys" not in cfg:
                cfg["keys"] = {}
            cfg["keys"][alias] = {
                "provider": selected_provider,
                "encrypted_key": encrypt_key(raw_key),
                "created_at": time.strftime("%Y-%m-%d %H:%M")
            }
            if default_active or not cfg.get("active_key_name"):
                cfg["active_key_name"] = alias

            save_config(cfg)
            console.print(f"[bold green][✓] Key '{alias}' ({selected_provider.upper()}) validated, encrypted, and saved![/bold green]\n")
            return alias
        else:
            console.print(f"[bold red][✗] Key Verification Failed:[/bold red] {reason}")
            console.print("[yellow][!] Try entering the key again or press Ctrl+C to cancel.[/yellow]\n")

def ensure_startup_key(cfg: dict) -> tuple[str, str, str]:
    active_alias = cfg.get("active_key_name")
    keys = cfg.get("keys", {})

    if not keys or not active_alias or active_alias not in keys:
        console.print(Panel(
            "[bold yellow]First-Time AI Service Configuration[/bold yellow]\n\n"
            "TREE requires at least one configured AI service (Gemini, ChatGPT, Claude, or OpenRouter)\n"
            "for automated vulnerability triage and security auditing.",
            border_style="yellow"
        ))
        active_alias = prompt_new_key_interactive(cfg, default_active=True)
        keys = cfg.get("keys", {})

    target_info = keys[active_alias]
    provider = target_info.get("provider", "gemini")
    plain_key = decrypt_key(target_info.get("encrypted_key", ""))

    with console.status(f"[cyan]Validating active key '{active_alias}' ({provider.upper()})...", spinner="dots"):
        valid, msg = validate_provider_key(provider, plain_key)

    if valid:
        console.print(f"[dim green][✓] AI Key Active: '{active_alias}' ({provider.upper()})[/dim green]")
        return active_alias, provider, plain_key
    else:
        console.print(f"[bold red][!] Active API key '{active_alias}' failed validation:[/bold red] {msg}")
        console.print("[yellow][*] Let's configure or switch to a working key now.[/yellow]\n")
        new_alias = prompt_new_key_interactive(cfg, default_active=True)
        target_info = cfg["keys"][new_alias]
        return new_alias, target_info["provider"], decrypt_key(target_info["encrypted_key"])

